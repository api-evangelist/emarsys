        "method": "POST",
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
              "value": "X-WSSE"
            },
            {
              "key": "value",
              "value": "{{apiKey}}"
            },
            {
              "key": "in",
              "value": "header"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"distribution_method\": \"<string>\",\n  \"origin\": \"<string>\",\n  \"origin_id\": 0,\n  \"time_range\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"contact_fields\": [\n    \"<integer>\"\n  ],\n  \"delimiter\": \",\",\n  \"add_field_names_header\": 1,\n  \"language\": \"<string>\",\n  \"ftp_settings\": {\n    \"host\": \"<uri>\",\n    \"port\": \"<string>\",\n    \"username\": \"<string>\",\n    \"password\": \"<string>\",\n    \"folder\": \"<string>\"\n  },\n  \"notification_url\": \"<uri>\"\n}",
